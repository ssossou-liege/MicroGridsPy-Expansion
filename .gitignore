# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.ipynb_checkpoints/

# Solver / model artifacts
*.lp
*.mps
*.sol
*.ilp
*.log

# Described sites and studies: a user's own work, not the project's.
projects/
projets/          # the former name, so an existing checkout stays clean
sites/

# Results (keep summaries, ignore bulk outputs)
results/**
# Git will not look inside an ignored directory, so the folders have to be readmitted
# before anything inside one of them can be.
!results/**/
!results/.gitkeep
!results/**/summary*.csv
!results/**/summary*.json
# A result kept for a reason has to be able to say what the reason is.
!results/**/README.md

# LaTeX build
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
docs/formulation/*.pdf

# Data (large imported inputs); keep provenance note
# data/**
# !data/README.md

# Climate Data Store download cache: reproducible from the CDS, so not versioned.
data/irradiance/raw/

# Weather series the tool fetches for a village described on this machine. Four megabytes
# of reanalysis apiece, reproducible from the CDS, and belonging to whoever asked for them
# rather than to the project. The two reference villages are the exception: the published
# results rest on their series, so those are versioned and readmitted by name.
data/irradiance/*_weather_hourly_*.csv
!data/irradiance/samionta_weather_hourly_2016_2025.csv
!data/irradiance/gbowele_weather_hourly_2016_2025.csv

# Manufacturer documentation: third-party copyright, kept locally as a source.
docs/generator/

# The reviewer agent reads the follow-up document and is written in the language that
# document is read in. Local, like the document itself.
.claude/agents/superviseur.md

# Supervisor follow-up and presentations -- kept local, never pushed.
# The public repository stays strictly about the model.
docs/suivi/
docs/presentation/
docs/figs/
docs/figs_*.py
docs/template/
*.odp
*.pptx
*.docx

# OS / editor
.DS_Store
.vscode/
.idea/
